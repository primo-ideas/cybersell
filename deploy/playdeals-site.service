# The site, listening on localhost only: Caddy faces the outside when there is a domain.
[Unit]
Description=Play Deals: site
After=network.target postgresql.service
Requires=postgresql.service

[Service]
Type=simple
User=playdeals
Group=playdeals
WorkingDirectory=/opt/playdeals/web
EnvironmentFile=/etc/playdeals/site.env
Environment=RAILS_ENV=production RAILS_MAX_THREADS=3 BUNDLE_DEPLOYMENT=1
ExecStart=/usr/bin/env bundle exec puma -C config/puma.rb
Restart=always
RestartSec=5

NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/playdeals/web/tmp /opt/playdeals/web/log
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
LockPersonality=true
RestrictRealtime=true

[Install]
WantedBy=multi-user.target
