# Emails players whose products reached their target price, started by
# playdeals-alerts.timer. See deploy/README.md.
[Unit]
Description=Play Deals: email players about their target prices
After=network-online.target postgresql.service
Wants=network-online.target
Requires=postgresql.service

[Service]
Type=oneshot
User=playdeals
Group=playdeals
WorkingDirectory=/opt/playdeals/web
EnvironmentFile=/etc/playdeals/site.env
Environment=RAILS_ENV=production RAILS_MAX_THREADS=1 BUNDLE_DEPLOYMENT=1
ExecStart=/usr/bin/env bundle exec rails alerts:deliver
# A server that does not answer must not hold up the following runs forever.
TimeoutStartSec=10min

Nice=10

NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/playdeals/web/tmp /opt/playdeals/web/log
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
LockPersonality=true
RestrictRealtime=true
