# Saves what cannot be fetched again, started by playdeals-backup.timer. See deploy/README.md.
[Unit]
Description=Play Deals: back up the accounts and the long-term market history
After=postgresql.service
Requires=postgresql.service

[Service]
Type=oneshot
# Reaches every database without a password, over the local socket.
User=postgres
Group=postgres
ExecStart=/opt/playdeals/bin/backup.sh
TimeoutStartSec=2h

# Leave room for the site, which readers are waiting on.
Nice=15
IOSchedulingClass=best-effort
IOSchedulingPriority=7

NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/backups/playdeals
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
LockPersonality=true
RestrictRealtime=true
