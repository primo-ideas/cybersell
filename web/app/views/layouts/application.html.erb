<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= [ content_for(:title), "Play Deals" ].compact.join(" · ") %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="description" content="What things sell for in games: auction house prices, trends and estimated sales. World of Warcraft, realm by realm.">
    <meta name="turbo-prefetch" content="false">
    <meta name="turbo-root" content="<%= request.script_name.presence || "/" %>">
    <meta name="color-scheme" content="dark">
    <meta name="theme-color" content="#0b0c0f">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <link rel="icon" href="<%= root_path %>icon.svg" type="image/svg+xml">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_include_tag "turbo.min", type: "module", "data-turbo-track": "reload" %>
    <%= javascript_include_tag "charts", defer: true, "data-turbo-track": "reload" %>
    <%= javascript_include_tag "interface", defer: true, "data-turbo-track": "reload" %>
  </head>

  <body>
    <%= render "layouts/header" %>
    <main>
      <% if flash[:alert] %>
        <p class="flash" role="alert"><%= flash[:alert] %></p>
      <% end %>
      <% if flash[:notice] %>
        <p class="flash flash-notice" role="status"><%= flash[:notice] %></p>
      <% end %>
      <%= yield %>
    </main>
    <footer class="site-footer">
      <p>World of Warcraft data from the Battle.net API, collected about once an hour. Sales are estimated.</p>
      <p>Not affiliated with Blizzard Entertainment. World of Warcraft is a trademark of Blizzard Entertainment, Inc.</p>
    </footer>
  </body>
</html>
