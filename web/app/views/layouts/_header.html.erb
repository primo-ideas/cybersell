<header class="site-header">
  <%= link_to root_path, class: "brand" do %>
    <span class="brand-mark" aria-hidden="true">P</span>Play Deals
  <% end %>
  <%= link_to "WoW", wow_path, class: "game-link", data: { tip: "World of Warcraft" }, "aria-label": "World of Warcraft" %>

  <% if current_realm %>
    <%= link_to realms_path(item: @item&.id, variant: @variant.presence), class: "realm-button",
          data: { tip: "Change realm" }, "aria-label": "Realm: #{current_realm.name} (#{current_realm.region.upcase}). Change realm" do %>
      <%= realm_label(current_realm) %>
    <% end %>

    <% unless content_for?(:page_search) %>
      <%= render "search/box", realm: current_realm, id: "site-search", css_class: "site-search" %>
    <% end %>
  <% end %>

  <nav class="header-nav" aria-label="Yours">
    <%= link_to watchlist_path, class: "header-link" do %>
      ★ Watchlist<% unless watchlist.empty? %> <small><%= watchlist.size %></small><% end %>
      <% if watchlist_hits.positive? %>
        <small class="watch-hits" data-tip="<%= pluralize(watchlist_hits, "product") %> at or below your target price on <%= current_realm.name %>"><%= watchlist_hits %> at target</small>
      <% end %>
    <% end %>
    <% if signed_in? %>
      <%= link_to "Journal", trades_path, class: "header-link" %>
      <%= link_to current_user.battletag.split("#").first, account_path, class: "header-link header-account",
            data: { tip: "Your account: preferences, alerts, characters" } %>
    <% else %>
      <%= link_to "Sign in", sign_in_path(return_to: (request.fullpath if request.get? && controller_name != "sessions")),
            class: "header-link header-sign-in" %>
    <% end %>
  </nav>
</header>
