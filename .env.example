# Copy to .env and fill in. Client created on https://develop.battle.net/access/clients
BLIZZARD_CLIENT_ID=
BLIZZARD_CLIENT_SECRET=
# Players sign in with this same client: add the site's callback to its redirect URLs,
# http://localhost:3000/auth/battlenet/callback here, and open the site at that address.

# Set by run.ps1. Only needed to run the fetcher by hand.
# DATABASE_URL=postgres://user:password@127.0.0.1:5432/playdeals_wow

# What to fetch: eu, eu/hyjal, eu/commodities, or several separated by commas.
# classic-eu or classic-eu/everlook for Mists of Pandaria Classic.
# Unset or empty: every realm of every region, without Classic. A lot of data and API calls.
# WOW_SCOPE=eu/commodities

# WOW_LOCALE=en_US
# WOW_CONCURRENCY=4
# WOW_ITEM_BATCH=1000
# WOW_HOURLY_RETENTION_DAYS=14
# WOW_POLL_SECONDS=600
